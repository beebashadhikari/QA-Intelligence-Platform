# QA Intelligence Platform
# Copy this file to .env and replace placeholder values as needed.

# QA REST API
QA_API_BASE_URL=http://127.0.0.1:8000

# MCP Server
MCP_HOST=127.0.0.1
MCP_PORT=8001

# Gemini / AI
# Add your own API key locally. Never commit the real key.
GEMINI_API_KEY=your_gemini_api_key_here
